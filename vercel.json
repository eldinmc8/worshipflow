{
  "rewrites": [
    {
      "source": "/p/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/p/:slug/:codigo",
      "destination": "/index.html"
    },
    {
      "source": "/e/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/e/:slug/:codigo",
      "destination": "/index.html"
    },
    {
      "source": "/tv",
      "destination": "/index.html"
    },
    {
      "source": "/web",
      "destination": "/index.html"
    },
    {
      "source": "/web/:pagina",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/terminos.html",
      "destination": "/web/terminos",
      "permanent": true
    },
    {
      "source": "/privacidad.html",
      "destination": "/web/privacidad",
      "permanent": true
    }
  ]
}
