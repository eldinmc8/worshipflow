{
  "rewrites": [
    {
      "source": "/robots.txt",
      "has": [
        {
          "type": "host",
          "value": "worshipflowapp.com"
        }
      ],
      "destination": "/robots-web.txt"
    },
    {
      "source": "/robots.txt",
      "has": [
        {
          "type": "host",
          "value": "www.worshipflowapp.com"
        }
      ],
      "destination": "/robots-web.txt"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots-app.txt"
    },
    {
      "source": "/p/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/p/:slug/:codigo",
      "destination": "/index.html"
    },
    {
      "source": "/e/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/e/:slug/:codigo",
      "destination": "/index.html"
    },
    {
      "source": "/tv",
      "destination": "/index.html"
    },
    {
      "source": "/web",
      "destination": "/index.html"
    },
    {
      "source": "/web/:pagina",
      "destination": "/index.html"
    },
    {
      "source": "/((?!assets/|api/)[^.]*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/terminos.html",
      "destination": "/web/terminos",
      "permanent": true
    },
    {
      "source": "/privacidad.html",
      "destination": "/web/privacidad",
      "permanent": true
    },
    {
      "source": "/terminos",
      "destination": "/web/terminos",
      "permanent": true
    },
    {
      "source": "/privacidad",
      "destination": "/web/privacidad",
      "permanent": true
    },
    {
      "source": "/reembolsos",
      "destination": "/web/reembolsos",
      "permanent": true
    },
    {
      "source": "/precios",
      "destination": "/web/precios",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "missing": [
        {
          "type": "host",
          "value": "worshipflowapp.com"
        },
        {
          "type": "host",
          "value": "www.worshipflowapp.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
