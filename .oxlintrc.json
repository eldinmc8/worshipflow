{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "oxc"
  ],
  "env": {
    "browser": true,
    "es2024": true
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "no-undef": "error",
    "react/jsx-no-undef": "error"
  },
  "overrides": [
    {
      "files": [
        "src/**/__tests__/**",
        "**/*.test.js",
        "vite.config.*",
        "scripts/**"
      ],
      "env": {
        "node": true
      }
    },
    {
      "files": [
        "src/sw.js"
      ],
      "env": {
        "serviceworker": true
      }
    },
    {
      "files": [
        "supabase/functions/**"
      ],
      "globals": {
        "Deno": "readonly"
      }
    }
  ]
}
